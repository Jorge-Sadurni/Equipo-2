{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar Proyecto Completo GCC",
            "type": "shell",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++11",
                "-Wall",
                "-Wextra",
                "-g",
                "${workspaceFolder}\\src\\main.cpp",
                "${workspaceFolder}\\src\\Competencia.cpp",
                "${workspaceFolder}\\src\\Disciplina.cpp",
                "${workspaceFolder}\\src\\Enfrentamiento.cpp",
                "${workspaceFolder}\\src\\Equipo.cpp",
                "${workspaceFolder}\\src\\Integrante.cpp",
                "${workspaceFolder}\\src\\Robot.cpp",
                "-I",
                "${workspaceFolder}\\include",
                "-o",
                "${workspaceFolder}\\build\\gestionRobots.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
